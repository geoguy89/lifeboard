{
  "name": "Kitchen Command",
  "description": "The board you glance at with your hands full: what is on today, what the weather is doing, and two sticky notes for the shopping and the reminders.",
  "aspect": "landscape",
  "orientation": "normal",
  "category": "official",
  "background": "linear-gradient(155deg, #1b1712 0%, #0c0a08 70%)",
  "widgets": [
    {
      "kind": "clock",
      "x": 2,
      "y": 2,
      "w": 22,
      "h": 14,
      "z": 0,
      "config": {
        "hour12": true,
        "show_meridiem": false,
        "weight": 300
      }
    },
    {
      "kind": "date",
      "x": 2,
      "y": 17,
      "w": 22,
      "h": 7,
      "z": 0,
      "config": {
        "short": true,
        "weekday": true
      }
    },
    {
      "kind": "weather",
      "x": 2,
      "y": 26,
      "w": 22,
      "h": 30,
      "z": 0,
      "config": {
        "layout": "full",
        "days": 4,
        "title": "",
        "show_feels_like": true,
        "show_precip": true
      }
    },
    {
      "kind": "postit",
      "x": 2,
      "y": 58,
      "w": 22,
      "h": 40,
      "z": 0,
      "config": {
        "heading": "Grocery List",
        "colour": "green",
        "content": "gtasks",
        "bullet_style": "check",
        "max_items": 10,
        "size": 1.9,
        "tilt": -1.5,
        "font": "hand"
      }
    },
    {
      "kind": "calendar",
      "x": 26,
      "y": 2,
      "w": 40,
      "h": 96,
      "z": 0,
      "config": {
        "style": "agenda",
        "title": "",
        "days": 5,
        "max_items": 14,
        "scroll_overflow": true
      }
    },
    {
      "kind": "postit",
      "x": 68,
      "y": 2,
      "w": 30,
      "h": 30,
      "z": 0,
      "config": {
        "heading": "Reminders",
        "colour": "yellow",
        "content": "gtasks",
        "bullet_style": "dot",
        "max_items": 7,
        "size": 2.1,
        "tilt": 1.5,
        "font": "hand"
      }
    },
    {
      "kind": "photos",
      "x": 68,
      "y": 34,
      "w": 30,
      "h": 64,
      "z": 0,
      "config": {
        "fit": "cover",
        "shuffle": true,
        "interval_seconds": 45,
        "transition_ms": 1200
      }
    }
  ]
}
