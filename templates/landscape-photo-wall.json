      "x": 3,
      "y": 6,
      "w": 40,
      "h": 20,
      "z": 1,
      "config": {
        "hour12": true,
        "show_meridiem": false
      }
    },
    {
      "kind": "date",
      "x": 3,
      "y": 27,
      "w": 40,
      "h": 6,
      "z": 1,
      "config": {}
    },
    {
      "kind": "weather",
      "x": 60,
      "y": 78,
      "w": 37,
      "h": 18,
      "z": 1,
      "config": {
        "layout": "compact",
        "title": ""
      }
    }
  ]
}
