# These are executed by Linux. A CRLF shebang makes the kernel look for an
# interpreter literally named "bash\r", which fails with a baffling
# "No such file or directory" naming a binary that plainly exists.
*.sh            text eol=lf
*.service       text eol=lf
*.mjs           text eol=lf
*.py            text eol=lf
*.js            text eol=lf
*.json          text eol=lf
*.md            text eol=lf
Dockerfile      text eol=lf
deploy/nm-*     text eol=lf
*.conf          text eol=lf
*.css           text eol=lf
*.html          text eol=lf
